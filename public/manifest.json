{
  "manifestVersion": 5,
  "id": "com.mastermotion.toolkit",
  "name": "MasterMotion & AI Toolkit Pro",
  "shortname": "MasterMotion",
  "version": "0.2.5",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request",
    "clipboard": "readAndWrite"
  },
  "entrypoints": [
    {
      "id": "mastermotion.panel",
      "type": "panel",
      "minimumSize": {
        "width": 280,
        "height": 360
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 640
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 720
      },
      "label": {
        "default": "MasterMotion"
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/dark.svg",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/light.svg",
          "scale": [1, 2],
          "theme": ["lightest", "light"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin-icon.svg",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
      "species": ["pluginList"]
    }
  ]
}
